<!--pages/delivery/delivery.wxml-->
<view class="page">
  <view class="section-header">
    <text class="section-title">配送服务</text>
  </view>

  <!-- 配送服务列表 -->
  <view class="delivery-list">
    <view class="delivery-item" wx:for="{{deliveryServices}}" wx:key="_id">
      <view class="delivery-image">
        <image src="{{item.image}}" mode="aspectFill" bindtap="previewImage" data-url="{{item.image}}"></image>
      </view>
      <view class="delivery-info">
        <view class="delivery-title">{{item.title}}</view>
        <view class="delivery-desc">{{item.description}}</view>
      </view>
    </view>

    <view wx:if="{{deliveryServices.length === 0}}" class="empty-state">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无配送服务</text>
    </view>
  </view>
</view>  