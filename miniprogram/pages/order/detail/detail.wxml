<view class="container">
  <view class="order-header">
    <view class="order-id">订单号：{{order._id}}</view>
    <view class="order-status" wx:if="{{order.pay_status}}">已支付</view>
    <view class="order-status unpaid" wx:else>未支付</view>
  </view>

  <view class="order-info">
    <view class="info-item">
      <text class="label">用户昵称</text>
      <text class="value">{{order.userNickName || '未知'}}</text>
    </view>
    <view class="info-item">
      <text class="label">联系电话</text>
      <text class="value">{{order.userPhone || '未绑定'}}</text>
    </view>
    <view class="info-item">
      <text class="label">订单类型</text>
      <text class="value">{{order.orderType === 'dineIn' ? '宿舍' : '打包'}}</text>
    </view>
    <view class="info-item">
      <text class="label">下单时间</text>
      <text class="value">{{formatTime(order.createTime)}}</text>
    </view>
    <view class="info-item">
      <text class="label">配送地址</text>
      <text class="value">{{order.university || ''}} {{order.dorm || ''}}</text>
    </view>
  </view>

  <view class="goods-section">
    <view class="section-title">商品清单</view>
    <view class="goods-list">
      <view class="goods-item" wx:for="{{order.goods}}" wx:key="index">
        <image class="goods-image" src="{{item.image}}" mode="aspectFill" />
        <view class="goods-info">
          <text class="goods-name">{{item.name}}</text>
          <text class="goods-spec">规格：{{item.spec || '默认'}}</text>
          <view class="goods-bottom">
            <text class="goods-price">¥{{item.price.toFixed(2)}}</text>
            <text class="goods-count">x{{item.count}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="total-section">
    <view class="total-item">
      <text class="label">商品总价</text>
      <text class="value">¥{{order.totalPrice.toFixed(2)}}</text>
    </view>
    <view class="total-item" wx:if="{{order.useMiandan}}">
      <text class="label">免单优惠</text>
      <text class="value discount">-¥{{order.totalPrice.toFixed(2)}}</text>
    </view>
    <view class="total-item total">
      <text class="label">实付金额</text>
      <text class="value">¥{{order.finalPrice.toFixed(2)}}</text>
    </view>
  </view>
</view>