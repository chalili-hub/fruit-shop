/* pages/myorder/deliveryAddress/deliveryAddress.wxss */
.page {
  min-height: 100vh;
  background-color: #f5f5f5;
  padding: 20rpx;
}

/* section header */
.section-header {
  margin-bottom: 30rpx;
  padding-top: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* address card */
.address-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.address-item {
  display: flex;
  align-items: flex-start;
}

.address-icon {
  font-size: 40rpx;
  margin-right: 20rpx;
}

.address-info {
  flex: 1;
}

.address-label {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 10rpx;
}

.address-detail {
  font-size: 26rpx;
  color: #666;
  line-height: 1.5;
}

/* info section */
.info-section {
  margin-bottom: 30rpx;
}

.info-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.info-icon {
  font-size: 40rpx;
  margin-bottom: 20rpx;
}

.info-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.info-text {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 10rpx;
  line-height: 1.4;
}

/* delivery section */
.delivery-section {
  margin-bottom: 30rpx;
}

.delivery-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.delivery-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.delivery-item {
  display: flex;
  align-items: flex-start;
}

.delivery-image {
  width: 100rpx;
  height: 100rpx;
  margin-right: 20rpx;
  border-radius: 10rpx;
  overflow: hidden;
}

.delivery-image image {
  width: 100%;
  height: 100%;
}

.delivery-content {
  flex: 1;
}

.delivery-text {
  font-size: 24rpx;
  color: #666;
  margin-bottom: 8rpx;
  line-height: 1.4;
}

/* action section */
.action-section {
  margin-top: 40rpx;
  margin-bottom: 40rpx;
}

.register-btn {
  width: 100%;
  background: linear-gradient(135deg, #4CAF50 0%, #81C784 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 25rpx 0;
  font-size: 28rpx;
  font-weight: bold;
}

.register-btn:active {
  opacity: 0.8;
  transform: scale(0.98);
}