<!--pages/myorder/deliveryAddress/deliveryAddress.wxml-->
<view class="page">
  <view class="section-header">
    <text class="section-title">配送地址查询</text>
  </view>

  <!-- 地址信息卡片 -->
  <view class="address-card">
    <view class="address-item">
      <view class="address-icon">📍</view>
      <view class="address-info">
        <view class="address-label">当前地址</view>
        <view class="address-detail">{{addressInfo.university || '未设置'}} - {{addressInfo.dorm || '未设置'}}</view>
      </view>
    </view>
  </view>

  <!-- 地址登记提示 -->
  <view class="info-section">
    <view class="info-card">
      <view class="info-icon">ℹ️</view>
      <view class="info-content">
        <view class="info-title">如何设置配送地址</view>
        <view class="info-text">1. 进入「我的」页面</view>
        <view class="info-text">2. 点击「地址登记」</view>
        <view class="info-text">3. 选择大学和宿舍位置</view>
        <view class="info-text">4. 点击「提交登记」</view>
      </view>
    </view>
  </view>

  <!-- 配送说明 -->
  <view class="delivery-section">
    <view class="delivery-card">
      <view class="delivery-title">配送说明</view>
      <view class="delivery-item">
        <view class="delivery-image">
          <image src="/images/tabBar/buy.png" mode="aspectFill"></image>
        </view>
        <view class="delivery-content">
          <view class="delivery-text">• 配送范围：深圳大学（粤海）校内</view>
          <view class="delivery-text">• 配送时间：10:00-22:00</view>
          <view class="delivery-text">• 配送方式：专人配送</view>
          <view class="delivery-text">• 送达时间：30分钟内</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 登记地址按钮 -->
  <view class="action-section">
    <button class="register-btn" bindtap="goToAddressRegister">
      <text>📝 去登记地址</text>
    </button>
  </view>
</view>