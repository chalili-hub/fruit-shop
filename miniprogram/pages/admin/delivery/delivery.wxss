/* pages/admin/delivery/delivery.wxss */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx;
}

.page-header {
  margin-bottom: 30rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.add-btn {
  background: #4CAF50;
  color: white;
  padding: 20rpx;
  border-radius: 10rpx;
  text-align: center;
  font-size: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(76, 175, 80, 0.3);
}

.delivery-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.delivery-item {
  background: white;
  border-radius: 10rpx;
  padding: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
}

.item-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.delivery-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  overflow: hidden;
}

.delivery-image image {
  width: 100%;
  height: 100%;
}

.delivery-info {
  flex: 1;
}

.delivery-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 8rpx;
}

.delivery-description {
  font-size: 24rpx;
  color: #666;
  line-height: 1.4;
}

.item-actions {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.action-btn {
  padding: 12rpx 24rpx;
  border-radius: 6rpx;
  font-size: 24rpx;
  text-align: center;
  border: 2rpx solid;
}

.action-btn.edit {
  color: #4CAF50;
  border-color: #4CAF50;
  background: white;
}

.action-btn.delete {
  color: #f44336;
  border-color: #f44336;
  background: white;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-dialog {
  background: white;
  border-radius: 16rpx;
  width: 80%;
  max-width: 500rpx;
  padding: 30rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 25rpx;
}

.form-label {
  font-size: 26rpx;
  color: #333;
  margin-bottom: 10rpx;
  display: block;
}

.form-input {
  border: 2rpx solid #ddd;
  border-radius: 8rpx;
  padding: 20rpx;
  font-size: 26rpx;
  width: 100%;
}

.image-upload {
  width: 100%;
  height: 200rpx;
  border: 2rpx dashed #ddd;
  border-radius: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.image-upload image {
  width: 100%;
  height: 100%;
  position: absolute;
  top: 0;
  left: 0;
}

.upload-placeholder {
  color: #999;
  font-size: 26rpx;
}

.modal-footer {
  display: flex;
  gap: 20rpx;
  margin-top: 30rpx;
}

.modal-btn {
  flex: 1;
  padding: 20rpx;
  border-radius: 8rpx;
  font-size: 28rpx;
  text-align: center;
}

.modal-btn.cancel {
  background: #f5f5f5;
  color: #666;
}

.modal-btn.confirm {
  background: #4CAF50;
  color: white;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
}

.loading-state {
  text-align: center;
  padding: 50rpx 0;
  color: #666;
}

.loading-text {
  font-size: 28rpx;
}

/* 响应式调整 */
@media (max-width: 375px) {
  .item-content {
    flex-direction: column;
    align-items: flex-start;
  }
  
  .delivery-image {
    width: 100%;
    height: 200rpx;
  }
  
  .item-actions {
    flex-direction: row;
    margin-top: 20rpx;
    width: 100%;
  }
  
  .action-btn {
    flex: 1;
  }
}